#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * TEMPORARY. Fills kickoff_at and venue_name on games created before migration 010.
 * Re-runnable: it only touches rows still missing a kickoff. Delete once the NOT NULL
 * migration has run on every database.
 *
 * Usage: bin/backfill_kickoff_at [--dry-run]
 */

require_once __DIR__ . '/../vendor/autoload.php';
require_once __DIR__ . '/../config/config.php';

use BeachVolleybot\Common\Extractors\TimeExtractor;
use BeachVolleybot\Common\GameDateResolver;
use BeachVolleybot\Database\Connection;
use BeachVolleybot\Game\ParsedTitle;

function info(string $message, string $color = ''): void
{
    $codes = ['green' => '32', 'red' => '31', 'yellow' => '33', 'cyan' => '36'];
    $code = $codes[$color] ?? '0';

    echo "\033[$code" . "m$message\033[0m" . PHP_EOL;
}

/** @param list<string> $entries */
function report(array $entries, string $heading): void
{
    if (empty($entries)) {
        return;
    }

    info(sprintf($heading, count($entries)), 'yellow');

    foreach ($entries as $entry) {
        info("  $entry", 'yellow');
    }
}

$isDryRun = in_array('--dry-run', $argv, true);

try {
    $db = Connection::get();
    $rows = $db->select('games', ['game_id', 'title', 'created_at'], ['kickoff_at' => null]);

    if (empty($rows)) {
        info('Nothing to backfill.', 'cyan');
        exit(0);
    }

    if ($isDryRun) {
        info('Dry run — no rows will be written.', 'yellow');
    }

    $filled = 0;
    $withoutTime = [];
    $withUnresolvableDate = [];

    foreach ($rows as $row) {
        $gameId = (int) $row['game_id'];
        $title = (string) $row['title'];
        $createdAt = new DateTimeImmutable((string) $row['created_at']);

        if (null === TimeExtractor::extract($title)) {
            $withoutTime[] = "#$gameId $title";

            continue;
        }

        // A title with no date token at all resolves to the creation day, which is what
        // every reader already computes for it. One that names a date the parser cannot
        // turn into a date would instead freeze that fallback in as a wrong kickoff.
        if (null !== GameDateResolver::extractRaw($title) && null === GameDateResolver::resolve($title, $createdAt)) {
            $withUnresolvableDate[] = "#$gameId $title";

            continue;
        }

        $parsedTitle = ParsedTitle::resolve($title, $createdAt);

        if (!$isDryRun) {
            $db->update('games', [
                'kickoff_at' => $parsedTitle->kickoffAt,
                'venue_name' => $parsedTitle->venueName,
            ], ['game_id' => $gameId]);
        }

        info(sprintf('  #%-5d %s → %s %s', $gameId, $title, $parsedTitle->kickoffAt, $parsedTitle->venueName ?? '—'));
        $filled++;
    }

    info(sprintf('%s %d of %d row(s).', $isDryRun ? 'Would fill' : 'Filled', $filled, count($rows)), 'green');

    report($withoutTime, '%d row(s) carry no time and stay NULL:');
    report($withUnresolvableDate, '%d row(s) carry a date the parser cannot resolve and stay NULL:');

    if (!empty($withoutTime) || !empty($withUnresolvableDate)) {
        info('Resolve these before making kickoff_at NOT NULL.', 'yellow');
    }
} catch (Throwable $e) {
    fprintf(STDERR, "\033[31m  Error: %s\033[0m" . PHP_EOL, $e->getMessage());
    exit(1);
}
